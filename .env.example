# Copy to .env for local development. Never commit the real file.

ENVIRONMENT=development
DEBUG=true

# Comma-separated. The web app's origin(s). No wildcards: credentialed
# requests require an exact origin, and a wildcard host invites Host-header
# poisoning behind a proxy.
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# The entire contents of the service account JSON on one line. This is a
# credential with full access to the Firebase project — treat it as a
# password. Leave unset to use Application Default Credentials, which is the
# better option on Cloud Run or GKE.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Powers the coach and the behavioural leak card.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct

# Limits
MAX_REQUEST_BYTES=262144
RATE_LIMIT_PER_MINUTE=60
COACH_RATE_LIMIT_PER_MINUTE=12

# ---------------------------------------------------------------------------
# Sign-in. All of this used to live in the browser bundle.
# ---------------------------------------------------------------------------

# Firebase Console -> Project settings -> General -> Web API Key.
# The Admin SDK can mint and verify tokens but cannot check a password, so the
# password flows go through Identity Toolkit with this key.
FIREBASE_WEB_API_KEY=

# The session cookie the browser holds. Opaque, HttpOnly, and unreadable by any
# script on the page.
SESSION_DAYS=5
# "lax" is right when the API and the app are same-site, which is what the
# rewrite in the client's vercel.json arranges. "none" is needed for genuinely
# cross-site setups, and then Safari's third-party cookie blocking applies.
SESSION_COOKIE_SAMESITE=lax
# Off only for plain-HTTP local development. Any deployment must leave it true.
SESSION_COOKIE_SECURE=false

# Google sign-in. Google Cloud console -> APIs & Services -> Credentials ->
# OAuth 2.0 Client ID (Web application). The authorised redirect URI must be
# exactly API_PUBLIC_URL + /api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser is sent after sign-in, and this service's own public origin
# — the one Google redirects back to.
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Email. Brevo sends the branded verification message; the key can send mail as
# you, so treat it as a password.
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RagDex
